# Database Configuration
# For local MySQL 8.0:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/opportunity_shield?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# Active Spring Profile (dev uses H2 in MySQL-mode with flyway, mysql uses external MySQL 8.0)
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8081

# JWT Authentication Secret (Minimum 256-bit base64/hex key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
